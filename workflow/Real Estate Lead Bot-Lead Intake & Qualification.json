    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.text || '';\n\nlet result;\n\ntry {\n  result = JSON.parse(rawText);\n} catch (error) {\n  result = {\n    follow_up_message: rawText\n  };\n}\n\nreturn [\n  {\n    json: {\n      follow_up_message: result.follow_up_message || ''\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
