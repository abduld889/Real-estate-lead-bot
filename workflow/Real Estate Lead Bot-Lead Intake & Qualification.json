      "id": "8de5a8c5-a832-477e-b21b-3dca69c4676a",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a friendly and professional real estate assistant.\nA potential buyer has been identified as a COLD lead.\nLead information:\nName: {{ $json.full_name }}Property Type: {{ $json.property_type }}Budget: {{ $json.budget }}Location: {{ $json.location }}Message: {{ $json.message }}Lead Status: {{ $json.lead_status }}Lead Score: {{ $json.lead_score }}Urgency: {{ $json.urgency }}Intent: {{ $json.intent }}\nCreate a short, friendly conversational response.\nRules:- If the Name field is empty, do NOT use a name or [Name].- Do not pressure the lead.- Acknowledge their interest.- Offer helpful assistance.- Ask one useful question if appropriate.- Keep the conversation open for the future.- Sound natural and human.- Do not mention AI, lead scoring, CRM, or internal workflow.\nReturn ONLY this JSON object and nothing else:\n{  \"follow_up_message\": \"The message to send to the lead\"}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
