      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        288,
        432
      ],
      "id": "c00b34e0-5294-4b3f-8a36-f8a1fa29b8f6",
      "name": "Ollama Chat Model3",
      "credentials": {
        "ollamaApi": {
          "id": "UrleYy5sSAImiuse",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.text || '';\n\nlet message = rawText;\n\nconst match = rawText.match(/\\{[\\s\\S]*\\}/);\n\nif (match) {\n  try {\n    const parsed = JSON.parse(match[0]);\n    message = parsed.follow_up_message || rawText;\n  } catch (error) {\n    message = rawText;\n  }\n}\n\nmessage = message\n  .replace(/\\[Name\\]/gi, '')\n  .replace(/^Hi\\s*,/i, 'Hi!')\n  .trim();\n\nconst lead = $('Insert row1').first().json;\n\nreturn [\n  {\n    json: {\n      lead_id: lead.lead_id,\n      full_name: lead.full_name,\n      email: lead.email,\n      phone: lead.phone,\n      property_type: lead.property_type,\n      budget: lead.budget,\n      location: lead.location,\n      message: lead.message,\n      lead_status: lead.lead_status,\n      lead_score: lead.lead_score,\n      urgency: lead.urgency,\n      intent: lead.intent,\n      summary: lead.summary,\n      recommended_action: lead.recommended_action,\n      follow_up_message: message\n    }\n  }\n];"
      },
