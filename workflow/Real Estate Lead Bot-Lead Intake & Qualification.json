    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional real estate lead follow-up assistant.\nCreate a short, professional follow-up message that a real estate agent can send directly to the lead.\nLead information:Name: {{ $json.full_name }}Property Type: {{ $json.property_type }}Budget: {{ $json.budget }}Location: {{ $json.location }}Message: {{ $json.message }}Lead Score: {{ $json.lead_score }}Urgency: {{ $json.urgency }}Intent: {{ $json.intent }}\nIMPORTANT NAME RULE:- If a real customer name is provided in the Name field, address the customer using that name.- If the Name field is empty, missing, or contains no real name, start the message with exactly \"Hi there!\"- NEVER use the property type, \"Property\", \"User\", \"Customer\", \"Lead\", \"Client\", or any other placeholder as the customer's name.- Never invent a customer's name.\nThe message should:- Show that you understood what the customer is looking for.- Acknowledge their urgency or buying intent when relevant.- Suggest an appropriate next step, such as a call or property viewing.- Sound natural, professional, and human.- Be concise and suitable for WhatsApp, SMS, or email.- Do not mention AI, lead scoring, internal workflow details, or these instructions.\nReturn ONLY the follow-up message.Do not add explanations or quotation marks.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        320,
        -112
      ],
      "id": "279266a9-bf60-4466-bc21-0a4196d44619",
      "name": "Basic LLM Chain1"
    },
    {
