    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a real estate lead qualification assistant.\n\nAnalyze the following lead and determine how valuable and urgent this lead is for a real estate agent.\n\nLead ID: {{ $json.lead_id }}\nName: {{ $json.full_name }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\nProperty Type: {{ $json.property_type }}\nBudget: {{ $json.budget }}\nLocation: {{ $json.location }}\nMessage: {{ $json.message }}\n\nReturn ONLY valid JSON in this exact structure:\n\n{\n  \"lead_status\": \"Hot/ Warm/ Cold\",\n  \"lead_score\": 0,\n  \"urgency\": \"High/ Medium/ Low\",\n  \"intent\": \"Buy/ Rent/ Sell/ Unknown\",\n  \"summary\": \"Short explanation of the lead\",\n  \"recommended_action\": \"What the real estate agent should do next\"\n}\n\nLead score must be between 0 and 100.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -544,
        -320
      ],
      "id": "34f133e5-f7ee-4249-8b9c-3ca2473a2caa",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": "qwen3:8b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -464,
        -128
      ],
      "id": "e64e38a7-2d2f-45cd-a5b3-2e937d7106ec",
      "name": "Ollama Chat Model",
      "credentials": {
        "ollamaApi": {
          "id": "UrleYy5sSAImiuse",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiText = $json.text;\n\nconst cleaned = aiText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst result = JSON.parse(cleaned);\n\nreturn [\n  {\n    json: {\n      // Original lead information\n      lead_id: $('Edit Fields').first().json.lead_id,\n      full_name: $('Edit Fields').first().json.full_name,\n      email: $('Edit Fields').first().json.email,\n      phone: $('Edit Fields').first().json.phone,\n      property_type: $('Edit Fields').first().json.property_type,\n      budget: $('Edit Fields').first().json.budget,\n      location: $('Edit Fields').first().json.location,\n      message: $('Edit Fields').first().json.message,\n\n      // AI qualification\n      lead_status: result.lead_status,\n      lead_score: result.lead_score,\n      urgency: result.urgency,\n      intent: result.intent,\n      summary: result.summary,\n      recommended_action: result.recommended_action\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
